[Unit]
Description=AIntegriX - Centralized ACP Server
After=network.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/opt/aintegrix
ExecStart=/opt/aintegrix/aintegrix --config /opt/aintegrix/aintegrix.yaml
Restart=on-failure
RestartSec=5
Environment=AINTEGRIX_API_KEY=${AINTEGRIX_API_KEY}
EnvironmentFile=-/opt/aintegrix/.env

[Install]
WantedBy=multi-user.target
